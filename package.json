{
  "name": "pi-hindsight",
  "version": "1.5.1",
  "description": "Hindsight self-hosted memory extension for Pi",
  "type": "module",
  "license": "ISC",
  "packageManager": "pnpm@10.17.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "hindsight",
    "memory"
  ],
  "files": [
    "index.ts",
    "api.ts",
    "banks.ts",
    "commands.ts",
    "config.ts",
    "logging.ts",
    "missions.ts",
    "renderers.ts",
    "retain.ts",
    "session.ts",
    "tools.ts",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:mission": "vitest run __tests__/mission-setup.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anh-chu/pi-hindsight.git"
  },
  "homepage": "https://github.com/anh-chu/pi-hindsight#readme",
  "bugs": {
    "url": "https://github.com/anh-chu/pi-hindsight/issues"
  },
  "author": "",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@marcfargas/pi-test-harness": "^0.6.1",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
